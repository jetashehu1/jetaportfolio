# Optional — Instagram API (Instagram API with Instagram Login).
# Server-side token, read by /api/instagram.js. Never prefix with VITE_.
INSTAGRAM_ACCESS_TOKEN=

# Set to "true" to let the site resolve `instagram:` permalinks in the data
# files through /api/instagram. Off by default so nothing is requested.
# VITE_INSTAGRAM_FEED=true
# VITE_INSTAGRAM_FEED_URL=/api/instagram
